[Unit]
Description=FusionPBX Tragofone synchronization worker
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
EnvironmentFile=-/etc/fusionpbx/tragofone.env
WorkingDirectory=/var/www/fusionpbx
ExecStart=/usr/bin/php /var/www/fusionpbx/app/tragofone/resources/jobs/scan.php
ExecStart=/usr/bin/php /var/www/fusionpbx/app/tragofone/resources/jobs/worker.php
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/cache/fusionpbx /var/log/fusionpbx /tmp

[Install]
WantedBy=multi-user.target
