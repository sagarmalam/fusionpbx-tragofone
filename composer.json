{
  "name": "ecosmob/fusionpbx-tragofone",
  "description": "Native FusionPBX companion for Tragofone provisioning",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-sodium": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "classmap": ["tragofone/resources/classes/"]
  },
  "autoload-dev": {
    "classmap": ["tests/"]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find tragofone tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  }
}
